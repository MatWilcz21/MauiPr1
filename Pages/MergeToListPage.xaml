<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.MergeToListPage"
             Title="MergeToListPage"
             xmlns:mergeproduct="clr-namespace:MauiApp1.ViewerModels"
             xmlns:products="clr-namespace:MauiApp1.Products"
             x:DataType="mergeproduct:MergeToListViewModel"
             >




    <Grid RowDefinitions="Auto,*,Auto" Padding="10" RowSpacing="15">

        <Button Text="Merge" Command="{Binding MergeCommand}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>

        <ScrollView VerticalScrollBarVisibility="Never" Grid.Row="1">
            <CollectionView ItemsSource="{Binding MergeProductsList}">

                <CollectionView.ItemTemplate>


                    <DataTemplate x:DataType="products:MergeProduct">

                        <SwipeView >
                            <SwipeView.LeftItems>

                                <SwipeItem Text="Del"
                               BackgroundColor="Red"
                               Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.ChangeStatusCommand}"
                               CommandParameter="{Binding .}"/>

                            </SwipeView.LeftItems>

                            <Border StrokeShape="RoundRectangle 10"
                                Padding="3">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BackgroundColor" Value="Red"/>

                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding Merge}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Padding="0.5" RowDefinitions="40,40" ColumnDefinitions=".90*,.10*" RowSpacing="3" ColumnSpacing="3">

                                    <Label Grid.Column="0"
                                           Grid.Row="0"
                                           Grid.RowSpan="2"
                                           VerticalTextAlignment="Center"
                                           FontSize="20">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1} => {2}">
                                                <Binding Path="Name"/>
                                                <Binding Path="OldCount"/>
                                                <Binding Path="NewCount"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Grid>
                            </Border>
                        </SwipeView>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>
        </ScrollView>

        <Grid RowDefinitions="50" ColumnDefinitions=".50*, .50*" RowSpacing="10" ColumnSpacing="5" Grid.Row="2">

            <Button Text="Edit products presets" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1"/>
            <Button CornerRadius="10" Text="X" Grid.Row="0" Grid.Column="1" BackgroundColor="Red"
    Command="{Binding DeleteAllCommand}"/>

        </Grid>

    </Grid>
</ContentPage>